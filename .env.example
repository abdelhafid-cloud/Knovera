# ── Application ──────────────────────────────────────────
APP_ENV=development
APP_NAME=RAG Enterprise Platform
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_secret
POSTGRES_DB=rag_enterprise
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://rag:rag_secret@localhost:5433/rag_enterprise

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# Ne pas traiter l'indexation dans Flask (garder 0). Mettre 1 seulement en dépannage.
PIPELINE_SYNC_FALLBACK=0
# DEBUG pour previews tronqués ; INFO par défaut
LOG_LEVEL=INFO

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-long-random-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=14
JWT_ALGORITHM=HS256
JWT_ISSUER=org.rag
JWT_AUDIENCE=org.rag-api
JWT_COOKIE_SAMESITE=Lax

# ── MinIO / S3 ───────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Qdrant ───────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Cohere (embeddings) ──────────────────────────────────
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_EMBED_DIMENSION=1024

# ── LLM (OpenAI-compatible) ──────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Documents ────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,xlsx

# ── Seed Super Admin ─────────────────────────────────────
SEED_SUPER_ADMIN_EMAIL=admin@rag.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin
